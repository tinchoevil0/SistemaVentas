@model SistemaVentas.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f6fb" />
    <title>@ViewData["Title"] - Sistema de Ventas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-shell">
        <section class="login-card" aria-labelledby="loginTitle">
            <div class="login-brand">
                <span class="login-brand-icon"><i class="bi bi-shop"></i></span>
                <span>Sistema de Ventas</span>
            </div>

            <div class="login-heading">
                <span class="login-eyebrow">BIENVENIDO DE NUEVO</span>
                <h1 id="loginTitle">Inicia sesión</h1>
                <p>Ingresa para continuar con la gestión de tu negocio.</p>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post" class="login-form">
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>

                <div class="login-field">
                    <label asp-for="Usuario">Usuario</label>
                    <div class="login-input-wrap">
                        <i class="bi bi-person"></i>
                        <input asp-for="Usuario" class="form-control" autocomplete="username" placeholder="Tu usuario" autofocus />
                    </div>
                    <span asp-validation-for="Usuario" class="field-validation"></span>
                </div>

                <div class="login-field">
                    <div class="d-flex justify-content-between align-items-center">
                        <label asp-for="Contrasena">Contraseña</label>
                        <span class="login-demo-hint">Cuenta de prueba</span>
                    </div>
                    <div class="login-input-wrap">
                        <i class="bi bi-lock"></i>
                        <input class="form-control" type="password" id="passwordInput" name="Contrasena" value="@Model.Contrasena" autocomplete="current-password" placeholder="Tu contraseña" />
                        <button class="login-password-toggle" type="button" id="togglePassword" aria-label="Mostrar contraseña"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="Contrasena" class="field-validation"></span>
                </div>

                <label class="login-remember">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <span>Mantener sesión iniciada</span>
                </label>

                <button class="login-submit" type="submit">
                    Iniciar sesión <i class="bi bi-arrow-right"></i>
                </button>

                <div class="login-divider"><span>o continúa con</span></div>
                <button class="login-google" type="button" title="La autenticación con Google estará disponible próximamente">
                    <span class="google-mark">G</span>
                    Continuar con Google
                    <span class="google-soon">Próximamente</span>
                </button>
            </form>

            <div class="login-footer">
                <i class="bi bi-shield-check"></i>
                Acceso protegido para la administración de tu negocio
            </div>
        </section>

        <aside class="login-aside">
            <div class="login-orb orb-one"></div>
            <div class="login-orb orb-two"></div>
            <div class="login-aside-content">
                <span class="login-aside-tag"><i class="bi bi-stars me-2"></i>Todo bajo control</span>
                <h2>Tu negocio,<br />en una sola vista.</h2>
                <p>Ventas, inventario y reportes reunidos en una experiencia simple y clara.</p>
                <div class="login-preview">
                    <div class="preview-top"><span>Resumen de ventas</span><i class="bi bi-three-dots"></i></div>
                    <div class="preview-number">Bs 12,840.50 <span><i class="bi bi-arrow-up-right"></i> 12.8%</span></div>
                    <div class="preview-bars">
                        <i style="--h:35%"></i><i style="--h:52%"></i><i style="--h:43%"></i><i style="--h:72%"></i><i style="--h:58%"></i><i style="--h:88%"></i><i style="--h:68%"></i><i style="--h:100%"></i><i style="--h:76%"></i><i style="--h:92%"></i>
                    </div>
                    <div class="preview-labels"><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span></div>
                </div>
            </div>
            <div class="login-aside-bottom"><i class="bi bi-lightning-charge-fill"></i> Información de tu negocio, al instante</div>
        </aside>
    </main>

    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const input = document.getElementById('passwordInput');
            const visible = input.type === 'password';
            input.type = visible ? 'text' : 'password';
            this.innerHTML = visible ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
            this.setAttribute('aria-label', visible ? 'Ocultar contraseña' : 'Mostrar contraseña');
        });
    </script>
</body>
</html>
