@model List<Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Productos</h2>
    <a class="btn btn-success" asp-action="Create">Nuevo producto</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th><th>Nombre</th><th>Categoría</th><th>Precio</th><th>Stock</th><th>Stock mínimo</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Nombre</td>
                <td>@p.Categoria?.Nombre</td>
                <td>@p.Precio.ToString("N2")</td>
                <td>
                    @p.Stock
                    @if (!p.TieneStock())
                    {
                        <span class="badge bg-danger">Sin stock</span>
                    }
                    else if (p.Stock <= p.StockMinimo)
                    {
                        <span class="badge bg-warning text-dark">Stock bajo</span>
                    }
                </td>
                <td>@p.StockMinimo</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@p.Id">Editar</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@p.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
