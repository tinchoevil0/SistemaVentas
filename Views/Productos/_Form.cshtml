@model Producto

<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CategoriaId" class="form-label">Categoría</label>
    <select asp-for="CategoriaId" class="form-select" asp-items="(SelectList)ViewBag.Categorias"></select>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Precio" class="form-label"></label>
        <input asp-for="Precio" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" class="form-control" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="StockMinimo" class="form-label">Stock mínimo</label>
        <input asp-for="StockMinimo" class="form-control" />
        <span asp-validation-for="StockMinimo" class="text-danger"></span>
    </div>
</div>

<button type="submit" class="btn btn-primary">Guardar</button>
<a class="btn btn-secondary" asp-action="Index">Cancelar</a>
