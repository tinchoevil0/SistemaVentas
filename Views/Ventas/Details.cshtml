@model Venta
@{
    ViewData["Title"] = "Venta " + Model.Id;
}

<h2>Venta N° @Model.Id</h2>

<div class="d-flex gap-2 mb-3 d-print-none">
    <button class="btn btn-primary" type="button" onclick="window.print()"><i class="bi bi-printer me-1"></i>Imprimir comprobante</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a>
</div>

<section class="card-panel receipt">
    <div class="mb-4">
        <h3 class="panel-title">Comprobante de venta #@Model.Id</h3>
        <div class="muted">Sistema de Ventas</div>
        <div class="mt-2"><strong>Cliente:</strong> @Model.Cliente?.Nombre</div>
        <div><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
<table class="table mini-table">
    <thead>
        <tr>
            <th>Producto</th>
            <th class="text-end">Cantidad</th>
            <th class="text-end">Precio</th>
            <th class="text-end">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Detalles)
        {
            <tr>
                <td>@d.Producto?.Nombre</td>
                <td class="text-end">@d.Cantidad</td>
                <td class="text-end">@d.Precio.ToString("N2")</td>
                <td class="text-end">@d.Subtotal.ToString("N2")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <th class="text-end">@Model.Total.ToString("N2")</th>
        </tr>
        <tr>
            <td colspan="3" class="text-end">Recibido</td>
            <td class="text-end">@Model.Recibido.ToString("N2")</td>
        </tr>
        <tr>
            <td colspan="3" class="text-end">Cambio</td>
            <td class="text-end">@Model.Cambio.ToString("N2")</td>
        </tr>
    </tfoot>
</table>

    <div class="text-end fw-bold">Gracias por su compra</div>
</section>
