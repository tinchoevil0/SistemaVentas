@model Venta
@{
    ViewData["Title"] = "Venta " + Model.Id;
}

<h2>Venta N° @Model.Id</h2>

<p>
    <strong>Cliente:</strong> @Model.Cliente?.Nombre<br />
    <strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
</p>

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th class="text-end">Cantidad</th>
            <th class="text-end">Precio</th>
            <th class="text-end">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Detalles)
        {
            <tr>
                <td>@d.Producto?.Nombre</td>
                <td class="text-end">@d.Cantidad</td>
                <td class="text-end">@d.Precio.ToString("N2")</td>
                <td class="text-end">@d.Subtotal.ToString("N2")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <th class="text-end">@Model.Total.ToString("N2")</th>
        </tr>
        <tr>
            <td colspan="3" class="text-end">Recibido</td>
            <td class="text-end">@Model.Recibido.ToString("N2")</td>
        </tr>
        <tr>
            <td colspan="3" class="text-end">Cambio</td>
            <td class="text-end">@Model.Cambio.ToString("N2")</td>
        </tr>
    </tfoot>
</table>

<a class="btn btn-secondary" asp-action="Index">Volver al listado</a>
<a class="btn btn-success" asp-action="Create">Nueva venta</a>
